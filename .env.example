# Copy to .env (which git ignores) and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Optional: override the Claude model (default claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5

# Flashpoint MCP (only needed for --panel flashpoint or --panel claude-mcp)
FLASHPOINT_MCP_URL=https://api.flashpoint.ai/mcp
FLASHPOINT_TOKEN=
# Name of the synthetic panel tool, and a JSON template for its arguments.
# Run `python scripts/flashpoint_probe.py` to see the real tool names and argument schema.
FLASHPOINT_PANEL_TOOL=panel
FLASHPOINT_PANEL_ARGS={"stimulus": "{text}", "question": "{question}", "n_personas": "{n}", "audience": "{segment}"}

# Optional: pay Flashpoint per call in USDC on Base (x402). Off unless X402_ENABLED=true.
# Use a separate small wallet for the program. Install: pip install -r requirements-wallet.txt
X402_ENABLED=false
WALLET_ADDRESS=
WALLET_PRIVATE_KEY=
X402_NETWORK=eip155:8453
X402_MAX_PER_CALL_USD=0.50
X402_MAX_PER_RUN_USD=2.00
